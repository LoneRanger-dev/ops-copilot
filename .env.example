# ==============================================================================
# OPS-COPILOT — ENVIRONMENT CONFIGURATION
# ------------------------------------------------------------------------------
#   cp .env.example .env.local
#   # paste your OpenAI key below
#   npm run dev
#
# ONLY ONE VARIABLE IS REQUIRED: OPENAI_API_KEY.
#
# Every other variable below is optional and already has a working default —
# they are listed so you can see what exists and override it if you want to.
# You can delete everything except OPENAI_API_KEY and the app still runs.
#
# .env.local is git-ignored. Never commit it.
# ==============================================================================


# ==============================================================================
# REQUIRED
# ==============================================================================

# Your OpenAI API key. This is the only value you must provide.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-paste-your-key-here


# ==============================================================================
# OPTIONAL — everything below has a working default
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------------------------

# Public base URL. No trailing slash — paths are concatenated directly.
# Default: http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Product name shown in the UI, page titles, and system prompts.
# Default: OpsCopilot
# NEXT_PUBLIC_APP_NAME=OpsCopilot

# Log level floor. Values: debug | info | warn | error
# Default: info
# LOG_LEVEL=debug

# NODE_ENV is set automatically by Next.js — "development" for `npm run dev`,
# "production" for `npm run build` and `npm run start`. Do not set it here.
# Overriding it will not change how Next.js builds, and it will desynchronise
# the environment guards in src/config/env.ts from the actual runtime.


# ------------------------------------------------------------------------------
# OPENAI MODELS
# ------------------------------------------------------------------------------

# Primary reasoning model — final synthesis, root cause analysis.
# Default: gpt-4o
# OPENAI_MODEL_PRIMARY=gpt-4o

# Fast model — routing, planning, classification, reranking, validation, and the
# floating widget. This handles the overwhelming majority of calls, so this one
# choice dominates total spend.
# Default: gpt-4o-mini
# OPENAI_MODEL_FAST=gpt-4o-mini

# Fallback when the primary is unavailable or rate-limited.
# Default: gpt-4o-mini
# OPENAI_MODEL_FALLBACK=gpt-4o-mini

# Embedding model.
# !  CHANGING THIS INVALIDATES EVERY STORED VECTOR. There is no migration path
#    short of re-embedding the entire corpus. Decide before Phase 5 ends.
# Default: text-embedding-3-small
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Embedding dimensionality. MUST match the model above.
# text-embedding-3-small = 1536, text-embedding-3-large = 3072.
# Default: 1536
# EMBEDDING_DIMENSIONS=1536

# Context and output ceilings, tokens.
# Defaults: 12000 / 2500
# MAX_CONTEXT_TOKENS=12000
# MAX_OUTPUT_TOKENS=2500

# Request timeouts, ms. No call is ever unbounded.
# Defaults: 45000 / 20000
# OPENAI_TIMEOUT_MS=45000
# OPENAI_EMBEDDING_TIMEOUT_MS=20000

# Max concurrent OpenAI requests per process (bulkhead).
# Default: 10
# OPENAI_MAX_CONCURRENCY=10


# ------------------------------------------------------------------------------
# SUPABASE — optional, arrives in Phase 2
# ------------------------------------------------------------------------------
# Leave unset for local development. Authentication runs in demo mode until a
# project is configured. `GET /api/v1/health` reports these as not_configured.

# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. BYPASSES ALL ROW-LEVEL SECURITY.
#  !  NEVER prefix this with NEXT_PUBLIC_.
#  !  NEVER import it into a client component.
#  !  Use ONLY in: the ingestion worker, the cron job handler, ServiceNow sync.
# SUPABASE_SERVICE_ROLE_KEY=


# ------------------------------------------------------------------------------
# POSTGRES — optional, arrives in Phase 4
# ------------------------------------------------------------------------------
# Leave unset for local development. Set only if you have a Postgres instance
# with the pgvector extension available.

# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
# DATABASE_POOL_URL=


# ------------------------------------------------------------------------------
# REDIS — optional, arrives in Phase 6
# ------------------------------------------------------------------------------
# Leave unset for local development. Without it, caching and rate limiting are
# skipped and every value is computed directly — slower, never broken.

# REDIS_URL=redis://localhost:6379

# Key namespace prefix. Default: opscopilot:dev
# REDIS_PREFIX=opscopilot:dev

# Cosine similarity required to serve a cached answer for a different query.
# Deliberately strict. Do not go below 0.92. Default: 0.95
# SEMANTIC_CACHE_THRESHOLD=0.95

# When true, Redis being unreachable disables caching but the app keeps serving.
# Default: true
# REDIS_FAIL_OPEN=true


# ------------------------------------------------------------------------------
# RAG
# ------------------------------------------------------------------------------

# Chunking. Defaults: 800 target, 120 overlap.
# CHUNK_SIZE_TOKENS=800
# CHUNK_OVERLAP_TOKENS=120

# Minimum rerank confidence to answer at all. Below this the assistant says it
# does not know rather than guessing. Raising it reduces hallucination and
# increases "I don't know" responses. Default: 0.55
# RAG_MIN_CONFIDENCE=0.55

# Maximum recursive retrieval passes. Default: 3
# MAX_RETRIEVAL_PASSES=3


# ------------------------------------------------------------------------------
# AGENT ORCHESTRATION
# ------------------------------------------------------------------------------

# Maximum plan steps. A query needing more should be escalated. Default: 6
# MAX_AGENT_STEPS=6

# Wall-clock deadlines, ms. The widget budget is far tighter — its entire value
# proposition is speed. Defaults: 45000 / 8000
# AGENT_DEADLINE_MS=45000
# WIDGET_DEADLINE_MS=8000


# ------------------------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------------------------

# Shared secret authenticating scheduled callbacks to /api/v1/jobs/process.
# A development default is used if unset. Generate a real one for any deployment:
#   openssl rand -hex 32
# CRON_SECRET=

# Redact detected PII before any text is sent to OpenAI.
# Forced true in production. Default: true
# PII_REDACTION_ENABLED=true


# ------------------------------------------------------------------------------
# DEMO MODE
# ------------------------------------------------------------------------------

# Enables seeded demo users, synthetic incidents, and the mock ServiceNow layer.
# Default: true (this is a hackathon build). Must be false in production.
# DEMO_MODE=true
